# Signal — environment template
# Copy to .env and adjust. Never commit real secrets.

# --- Database ---
# SQLite is the default for local demo (no extra services required).
# For PostgreSQL (Docker Compose):
# DATABASE_URL=postgresql+psycopg://signal:signal@localhost:5432/signal
DATABASE_URL=sqlite:///./signal.db

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Frontend ---
# Leave empty to call /api through the Next.js proxy (used on Render).
# Set this only if the browser should hit the API origin directly.
NEXT_PUBLIC_API_URL=
BACKEND_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:3000

# --- Optional LLM (OpenAI-compatible). Leave empty to use the rule-based normalizer. ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Decision engine (override only if you need to tune the prototype) ---
FRESHNESS_VERY_FRESH_MINUTES=10
FRESHNESS_FRESH_MINUTES=30
FRESHNESS_AGING_MINUTES=60
REPORT_EXPIRY_MINUTES=120
AVOID_CONFIDENCE_THRESHOLD=0.80
AVOID_MIN_INDEPENDENT_SOURCES=2
LOCATION_CLUSTER_METERS=250
ROUTE_PROXIMITY_METERS=400
